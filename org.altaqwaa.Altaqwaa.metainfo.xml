<component type="desktop-application">
  <id>org.altaqwaa.Altaqwaa</id>
  <name>Altaqwaa</name>
  <summary>Quran, adhkar, and prayer times</summary>
  <summary xml:lang="ar">القرآن وأذكار ومواقيت الصلاة</summary>
  <url type="homepage">https://github.com/rn0x/altaqwaa-desktop</url>
  <url type="bugtracker">https://github.com/rn0x/altaqwaa-desktop/issues</url>
  <url type="donation">https://github.com/sponsors/rn0x</url>
